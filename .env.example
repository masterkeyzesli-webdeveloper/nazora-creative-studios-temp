# ---------------------------------------------------------------------------
# Nazora Creative Studios — environment configuration
#
# Copy this file to `.env` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- AI assistant (server-side only — never exposed to the browser) ---------
# API key used by server/chatHandler.mjs to call the chat model.
# REQUIRED for the live assistant; without it the chatbot shows its documented
# WhatsApp / enquiry-form fallback instead of pretending to answer.
OPENAI_API_KEY=

# Optional overrides. Defaults shown.
AI_BASE_URL=https://freebuff.com/api/v1/paid
AI_MODEL=gpt-4o-mini

# --- Contact form delivery (optional) --------------------------------------
# Absolute URL of a server-side endpoint that accepts the enquiry JSON and
# stores/delivers it (for example a Supabase Edge Function, Cloudflare Worker,
# or form service endpoint). It must NOT be a public database URL with an
# exposed service-role key.
#
# When this is unset the contact form does not claim success: it prepares the
# enquiry as a reviewable WhatsApp / email message instead.
VITE_ENQUIRY_ENDPOINT=
